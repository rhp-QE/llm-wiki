SHELL=/bin/bash
PATH=/root/.nvm/versions/node/v22.22.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CRON_TZ=Asia/Shanghai

# Create one Feishu diary document per day, before the 08:00 reminder.
55 7 * * * /root/llm-wiki/scripts/create_daily_diary_doc.sh >> /root/llm-wiki/automation/logs/create_daily_diary_doc.cron.log 2>&1

# Catch up after reboot or resume. The script is idempotent per date.
@reboot DIARY_NOT_BEFORE=07:55 /root/llm-wiki/scripts/create_daily_diary_doc.sh >> /root/llm-wiki/automation/logs/create_daily_diary_doc.cron.log 2>&1
*/15 8-23 * * * DIARY_NOT_BEFORE=07:55 DIARY_QUIET_IF_EXISTS=1 /root/llm-wiki/scripts/create_daily_diary_doc.sh >> /root/llm-wiki/automation/logs/create_daily_diary_doc.cron.log 2>&1
55 23 * * * DIARY_NOT_BEFORE=07:55 DIARY_QUIET_IF_EXISTS=1 /root/llm-wiki/scripts/create_daily_diary_doc.sh >> /root/llm-wiki/automation/logs/create_daily_diary_doc.cron.log 2>&1
